<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- set pageTitle = title or site.name -%}
  {%- set fullTitle = pageTitle if pageTitle == site.name else pageTitle + " · " + site.name -%}
  <title>{{ fullTitle }}</title>

  {%- set metaDesc = description or excerpt or site.description -%}
  <meta name="description" content="{{ metaDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph / social -->
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ image or site.defaultImage }}">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Fonts: engraved display serif + clean body sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/theme.css">
  {%- if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
  {%- block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
