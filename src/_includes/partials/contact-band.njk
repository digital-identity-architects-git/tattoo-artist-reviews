<section class="contact-band">
  <div class="contact-band-inner">
    <p class="contact-band-kicker">Think you're the best ink in your city?</p>
    <h2 class="contact-band-title">Get reviewed.</h2>
    <p class="contact-band-sub">
      We feature the baddest tattoo artist in every city in America. Pitch yourself —
      or someone who deserves it — and your shop could be next on the wall.
    </p>
    <div class="contact-band-actions">
      <a class="btn btn-gold" href="{{ site.contact.instagramUrl }}" target="_blank" rel="noopener">DM @{{ site.contact.instagram }}</a>
      <a class="btn btn-outline" href="{{ site.contact.phoneHref }}">Text {{ site.contact.phone }}</a>
      <a class="btn btn-outline" href="mailto:{{ site.contact.email }}">Email us</a>
    </div>
  </div>
</section>
